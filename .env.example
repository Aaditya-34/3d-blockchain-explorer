# Optional: Custom Ethereum JSON-RPC Provider URL (Mainnet)
# Default public endpoint used: https://ethereum-rpc.publicnode.com
# Examples:
# VITE_RPC_URL=https://cloudflare-eth.com
# VITE_RPC_URL=https://eth.llamarpc.com
# VITE_RPC_URL=https://mainnet.infura.io/v3/YOUR_API_KEY
VITE_RPC_URL=https://ethereum-rpc.publicnode.com
